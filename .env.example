# =============================================================================
# QwenProxy — .env de referência (perfil PERFORMANCE)
# Copie para .env e ajuste. Todos os valores abaixo passam por validação Zod;
# valores inválidos derrubam o boot.
# =============================================================================

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Auth / segurança
# ---------------------------------------------------------------------------
# Chave para /v1/*. Vazia = sem auth. Se exposto à internet, DEFINA uma chave
# forte aqui (a dashboard admin usa ADMIN_PASSWORD ou fallback para API_KEY).
API_KEY=
# Força auth mesmo sem API_KEY? (se true sem API_KEY, o servidor recusa boot
# de requests com 500). Recomendado true se exposto à internet.
AUTH_REQUIRED=false
# Senha da dashboard admin (GET /admin). Fallback: API_KEY.
ADMIN_PASSWORD=
# Chaves de usuários multi-cota: "email:chave,rpm,concurrency" separadas por ';'
USER_API_KEYS=
# Limites por usuário (default). Suba USER_MAX_CONCURRENCY para mais paralelismo
# por usuário; USER_RATE_LIMIT_RPM é a janela de 1min.
USER_RATE_LIMIT_RPM=120
USER_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Qwen — endpoints e credenciais
# ---------------------------------------------------------------------------
QWEN_BASE_URL=https://chat.qwen.ai
QWEN_HTTP_ENDPOINT=https://api.qwen.ai/v1/chat
# Chave da API oficial (usada no endpoint HTTP, quando configurada).
QWEN_API_KEY=
# Credenciais para login automático / rotação de contas (accounts.json ou UI).
QWEN_EMAIL=
QWEN_PASSWORD=
# true = ignora contas e usa só guest mode.
QWEN_GUEST_MODE_ONLY=false

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------
BROWSER=chromium
HEADLESS=true
USER_DATA_DIR=./qwen_profiles
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
LOG_CONSOLE=false

# ===========================================================================
# PERFORMANCE — os maiores multiplicadores de throughput/latência
# ===========================================================================

# --- Fast path direto (maior ganho de TTFT) --------------------------------
# POST de completions direto do Node com os headers anti-bot capturados,
# pulando a ponte CDP (page.evaluate) e a espera de página. Custo zero de
# bridge por chunk. Fallback automático para o relay do browser em TMD; um
# circuit breaker por conta desliga por 5min após 3 falhas consecutivas.
QWEN_DIRECT_FETCH=true

# --- Warm pool (elimina ~800-2000ms de criação de chat por request) --------
# Chats pré-criados por conta, usados sem custo. SIZE=0 desliga.
WARM_POOL_SIZE=3
WARM_POOL_LOW_WATER=2
WARM_POOL_TTL_MS=600000
WARM_POOL_STARTUP=true

# --- Concorrência por conta REAL (todas as lanes compartilham este teto) ---
# lanes além do cap NÃO aumentam throughput — só queimam recurso e geram 429.
# Suba de 2 → 3 apenas se vir fila sem 429s.
ACCOUNT_MAX_CONCURRENT_STREAMS=2
# Tempo que uma request espera slot livre antes de virar retryable (roteador
# tenta outra conta/lane).
ACCOUNT_STREAM_SLOT_WAIT_MS=30000

# --- Lanes (single-account) ------------------------------------------------
# Uma conta dividida em contexts isolados para concorrência real. Em modo
# multi-conta, ACCOUNT_LANES não se aplica (cada conta já é 1 stream slot).
SINGLE_ACCOUNT_MODE=false
SINGLE_ACCOUNT_ID=
SINGLE_ACCOUNT_EMAIL=
ACCOUNT_LANES=2

# --- Guard degenerado (latência x robustez) --------------------------------
# O guard segura até ~800 bytes de resposta antes de flushar (custo de TTFT em
# TODA resposta). Modes:
#   prone  (default) guard só em turnos economical e tool loops (onde "Yes"
#          degenerado é provável) — zero custo no chat comum
#   always guard sempre (comportamento histórico)
#   off    nunca — menor time-to-first-byte, sem retry degenerado/tool-call
STREAM_DEGENERATE_GUARD=prone

# --- Sessões híbridas (economia de contexto) -------------------------------
HYBRID_SESSIONS_ENABLED=true
# Verificação do histórico server-side antes de economizar. Cada verificação é
# um fetch de histórico; throttled por HYBRID_SESSION_VERIFY_EVERY_MS para
# eliminar o round-trip em praticamente todos os turnos de um loop.
HYBRID_SESSION_VERIFY=true
HYBRID_SESSION_VERIFY_EVERY_MS=60000
HYBRID_SESSION_TTL_MS=86400000

# --- Headers anti-bot (TTL + refresh em background) ------------------------
# TTL de 30min mantém a sessão viva; refresh em background evita header velho
# com TMD sem custo no primeiro request.
HEADERS_TTL_MS=1800000
BACKGROUND_HEADER_REFRESH=true

# --- Boot otimizado --------------------------------------------------------
# Poucas contas de cada vez + stagger para não tomar 429 na subida.
ACCOUNT_INIT_CONCURRENCY=2
ACCOUNT_INIT_STAGGER_MIN_MS=250
ACCOUNT_INIT_STAGGER_MAX_MS=800
# Pré-captura de headers no boot (primeiro request sem interceptação).
PRECAPTURE_HEADERS_STARTUP=true
PRECAPTURE_HEADERS_CONCURRENCY=1
PRECAPTURE_HEADERS_STAGGER_MIN_MS=2500
PRECAPTURE_HEADERS_STAGGER_MAX_MS=5000

# --- Session keeper --------------------------------------------------------
# Renova cookies/headers periodicamente para evitar sessões expiradas.
SESSION_KEEPER_ENABLED=true

# --- Limiar de prompt grande (bytes) ---------------------------------------
# Prompts acima deste tamanho são uploadados para o OSS do Qwen (evita payload
# inchado e TMD); abaixo ficam inline. 512KB é um bom meio-termo para a maioria.
LARGE_PROMPT_THRESHOLD=124288

# Se true, prompts grandes são colados inline (texto completo) em vez de
# enviados como arquivo anexo. ATENÇÃO: inline de 100k+ bytes ativa o anti-bot
# da Qwen e pode disparar o captcha Baxia. Deixe false (padrão, recomendado) para
# fazer upload do arquivo e evitar o captcha.
LARGE_PROMPT_INLINE=true

# ===========================================================================
# Timeouts (ms) — toleram upstream lento sem derrubar a geração
# ===========================================================================
NAVIGATION_TIMEOUT=90000
PAGE_TIMEOUT=60000
HTTP_TIMEOUT=45000
HEADERS_TIMEOUT=45000
CHAT_TIMEOUT=120000
STREAM_IDLE_TIMEOUT=180000

# ===========================================================================
# Cache (segundos)
# ===========================================================================
CACHE_TTL=3600
RESPONSE_TTL=1800

# ===========================================================================
# Métricas e Watchdog
# ===========================================================================
METRICS_INTERVAL=10000
WATCHDOG_INTERVAL=5000
WATCHDOG_FAILURES=3
RAM_WARNING=70
RAM_CRITICAL=90
WS_WARNING=40
WS_CRITICAL=80
