{
  "name": "@pedrofariasx/qwenproxy",
  "version": "1.37.1",
  "description": "Local OpenAI-compatible proxy API that routes requests to Qwen (chat.qwen.ai) via Playwright browser automation.",
  "scripts": {
    "prestart": "npm run build:admin",
    "start": "npx tsx src/index.ts",
    "dev": "concurrently -k -n server,web -c green,cyan \"npx tsx watch src/index.ts --dev\" \"npm --prefix web run dev\"",
    "start:firefox": "npx tsx src/index.ts --browser=firefox",
    "start:chrome": "npx tsx src/index.ts --browser=chrome",
    "start:edge": "npx tsx src/index.ts --browser=edge",
    "login": "npx tsx src/login.ts",
    "login:firefox": "npx tsx src/login.ts --browser=firefox",
    "login:chrome": "npx tsx src/login.ts --browser=chrome",
    "login:edge": "npx tsx src/login.ts --browser=edge",
    "build": "tsc -p tsconfig.build.json",
    "build:admin": "npm --prefix web install && npm --prefix web run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test src/tests/unit/*.test.ts",
    "test:e2e": "tsx --test src/tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docker:verify": "node scripts/check-docker-versions.mjs",
    "docker:build": "npm run docker:verify && docker compose build",
    "docker:up": "npm run docker:verify && docker compose up -d && docker compose ps",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:shell": "docker compose exec qwenproxy sh",
    "docker:health": "docker compose ps && docker inspect --format='{{json .State.Health}}' qwenproxy 2>/dev/null || true",
    "docker:clean": "docker compose down -v --remove-orphans"
  },
  "keywords": [
    "openai",
    "proxy",
    "qwen",
    "playwright",
    "llm",
    "api",
    "chat-completions"
  ],
  "author": "Pedro Farias",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "ajv": "^8.20.0",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^12.10.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.21",
    "playwright": "^1.60.0",
    "tiktoken": "^1.0.22",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/ajv": "^0.0.5",
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.5.0",
    "semantic-release": "^25.0.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "bin": {
    "qwenproxy": "./bin/qwenproxy.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "web/dist/**/*",
    "web/public/**/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  }
}
